import React, { useState, useRef, useEffect } from 'react';
import { View, Text, StyleSheet, Pressable, TouchableOpacity, StatusBar } from 'react-native';
import { Ionicons } from '@expo/vector-icons';

export default function App() {
  const [gameState, setGameState] = useState('idle');
  const [targetTime, setTargetTime] = useState(0);
  const [elapsedTime, setElapsedTime] = useState(0); 
  const [displayTime, setDisplayTime] = useState(0); 
  const [points, setPoints] = useState(0);
  const [highScore, setHighScore] = useState(0);
  const [lastDiff, setLastDiff] = useState(0);
  const [earned, setEarned] = useState(0);
  
  const [isTimerVisible, setIsTimerVisible] = useState(false);
  const startTimeRef = useRef(0);

  const generateNewTarget = () => {
    const randomCentiseconds = Math.floor(Math.random() * 900) + 100;
    return randomCentiseconds * 10;
  };

  useEffect(() => {
    setTargetTime(generateNewTarget());
  }, []);

  useEffect(() => {
    let interval;
    if (gameState === 'running' && isTimerVisible) {
      interval = setInterval(() => {
        setDisplayTime(Date.now() - startTimeRef.current);
      }, 10); 
    }
    return () => clearInterval(interval); 
  }, [gameState, isTimerVisible]);

  const formatTime = (ms) => {
    const seconds = Math.floor(ms / 1000);
    const centiseconds = Math.floor((ms % 1000) / 10);
    return `${seconds.toString().padStart(2, '0')}:${centiseconds.toString().padStart(2, '0')}`;
  };

  const handleAction = () => {
    if (gameState === 'idle') {
      setGameState('running');
      startTimeRef.current = Date.now();
      setDisplayTime(0);
    } else if (gameState === 'running') {
      const endTime = Date.now();
      const elapsed = endTime - startTimeRef.current;
      
      setElapsedTime(elapsed);
      setDisplayTime(elapsed); 

      const targetDisplayValue = Math.floor(targetTime / 10);
      const elapsedDisplayValue = Math.floor(elapsed / 10);
      
      const visualDiff = Math.abs(elapsedDisplayValue - targetDisplayValue);
      setLastDiff(visualDiff);

      if (visualDiff < 10) { 
        const earnedPoints = 10 - visualDiff;
        
        setEarned(earnedPoints);
        const newTotal = points + earnedPoints;
        setPoints(newTotal);
        
        if (newTotal > highScore) {
          setHighScore(newTotal);
        }
      } else { 
        setEarned(0);
        setPoints(0);
      }

      setGameState('result');
    } else if (gameState === 'result') {
      setTargetTime(generateNewTarget());
      setElapsedTime(0);
      setDisplayTime(0);
      setGameState('idle');
    }
  };

  return (
    <View style={styles.container}>
      <StatusBar barStyle="light-content" />
      
      {/* Cabeçalho de Pontuação */}
      <View style={styles.header}>
        <View style={styles.scoreBoard}>
          <View style={styles.scoreCard}>
            <Text style={styles.scoreLabel}>RECORDE</Text>
            <Text style={styles.scoreValue}>{highScore}</Text>
          </View>
          <View style={styles.scoreCard}>
            <Text style={styles.scoreLabel}>PONTOS</Text>
            <Text style={styles.scoreValue}>{points}</Text>
          </View>
        </View>
        
        <TouchableOpacity 
          style={styles.eyeButton} 
          onPress={() => setIsTimerVisible(!isTimerVisible)}
          activeOpacity={0.7}
        >
          <Ionicons 
            name={isTimerVisible ? "eye" : "eye-off"} 
            size={28} 
            color={isTimerVisible ? "#00E676" : "#757575"} 
          />
        </TouchableOpacity>
      </View>

      {/* Área Central do Jogo */}
      <View style={styles.gameArea}>
        <Text style={styles.label}>ALVO</Text>
        <Text style={styles.targetText}>
          {formatTime(targetTime)}
        </Text>

        <View style={styles.timerContainer}>
          <Text style={styles.timer}>
            {gameState === 'running' 
              ? (isTimerVisible ? formatTime(displayTime) : '--:--') 
              : formatTime(elapsedTime)}
          </Text>
        </View>

        {/* Feedback visual */}
        <View style={styles.feedbackContainer}>
          {gameState === 'result' && (
            <View style={[styles.feedbackBadge, lastDiff < 10 ? styles.badgeWin : styles.badgeLose]}>
              <Text style={styles.feedbackText}>
                {lastDiff < 10 ? `+${earned} PONTOS` : 'PERDEU!'}
              </Text>
              <Text style={styles.diffText}>
                ERRO: {lastDiff}
              </Text>
            </View>
          )}
        </View>
      </View>

      {/* Botão Vermelho 3D Clássico */}
      <Pressable onPress={handleAction}>
        {({ pressed }) => (
          <View style={styles.buttonOuter}>
            <View style={[styles.buttonInner, pressed && styles.buttonInnerPressed]}>
              <Text style={styles.buttonText}>
                {gameState === 'idle' ? 'COMEÇAR' : 
                 gameState === 'running' ? 'PARAR' : 
                 'PRÓXIMO'}
              </Text>
            </View>
          </View>
        )}
      </Pressable>
    </View>
  );
}

